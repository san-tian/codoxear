#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WEB_PID_FILE="$ROOT_DIR/.tmp/codoxear-web.pid"
RUST_PID_FILE="$ROOT_DIR/.tmp/codoxear-rust.pid"
WEB_LOG_FILE="$ROOT_DIR/.tmp/codoxear-web.log"
RUST_LOG_FILE="$ROOT_DIR/.tmp/codoxear-rust.log"
PYTHON_BIN="$ROOT_DIR/.venv/bin/python"
NOVA_BIN="$ROOT_DIR/backend-rs/target/release/codoxear-backend-rs"

usage() {
  cat <<'USAGE'
Usage: scripts/codoxear-local <start|stop|restart|status|logs>
USAGE
}

require_runtime() {
  if [[ ! -f "$ROOT_DIR/.env" ]]; then
    echo "error: missing $ROOT_DIR/.env" >&2
    exit 1
  fi
  if [[ ! -x "$PYTHON_BIN" ]]; then
    echo "error: missing $PYTHON_BIN" >&2
    exit 1
  fi
  if [[ ! -x "$NOVA_BIN" ]]; then
    echo "error: missing $NOVA_BIN (run: cd $ROOT_DIR/backend-rs && cargo build --release)" >&2
    exit 1
  fi
  if [[ ! -f "$ROOT_DIR/frontend/dist/index.html" ]]; then
    echo "error: missing frontend build (run: cd $ROOT_DIR/frontend && npm run build)" >&2
    exit 1
  fi
}

running_pid() {
  local pid_file="$1"
  if [[ ! -f "$pid_file" ]]; then
    return 1
  fi
  local pid
  pid="$(cat "$pid_file")"
  if [[ -z "$pid" ]]; then
    rm -f "$pid_file"
    return 1
  fi
  if kill -0 "$pid" 2>/dev/null; then
    printf '%s\n' "$pid"
    return 0
  fi
  rm -f "$pid_file"
  return 1
}

start_server() {
  require_runtime
  mkdir -p "$ROOT_DIR/.tmp"
  local web_pid rust_pid
  if web_pid="$(running_pid "$WEB_PID_FILE")" || rust_pid="$(running_pid "$RUST_PID_FILE")"; then
    echo "error: Codoxear already running" >&2
    exit 1
  fi

  cd "$ROOT_DIR"
  set -a
  # shellcheck disable=SC1091
  source "$ROOT_DIR/.env"
  set +a

  setsid env \
    CODOXEAR_BIND_HOST=127.0.0.1 \
    CODOXEAR_BIND_PORT=8787 \
    "$NOVA_BIN" >>"$RUST_LOG_FILE" 2>&1 < /dev/null &
  rust_pid=$!
  echo "$rust_pid" > "$RUST_PID_FILE"

  setsid env \
    CODEX_WEB_HOST=0.0.0.0 \
    CODEX_WEB_PORT=8743 \
    CODEX_WEB_NOVA=1 \
    CODEX_WEB_NOVA_API_BASE=http://127.0.0.1:8787 \
    "$PYTHON_BIN" -m codoxear.server >>"$WEB_LOG_FILE" 2>&1 < /dev/null &
  web_pid=$!
  echo "$web_pid" > "$WEB_PID_FILE"
  sleep 2
  if ! kill -0 "$rust_pid" 2>/dev/null || ! kill -0 "$web_pid" 2>/dev/null; then
    rm -f "$WEB_PID_FILE" "$RUST_PID_FILE"
    echo "error: Codoxear failed to start; check logs in $ROOT_DIR/.tmp" >&2
    exit 1
  fi

  echo "started Codoxear Nova"
  echo "web pid: $web_pid"
  echo "rust pid: $rust_pid"
  echo "web log: $WEB_LOG_FILE"
  echo "rust log: $RUST_LOG_FILE"
}

stop_server() {
  local failed=0
  if ! running_pid "$WEB_PID_FILE" >/dev/null && ! running_pid "$RUST_PID_FILE" >/dev/null; then
    echo "error: Codoxear is not running" >&2
    exit 1
  fi
  for pid_file in "$WEB_PID_FILE" "$RUST_PID_FILE"; do
    local pid=""
    if pid="$(running_pid "$pid_file" 2>/dev/null)"; then
      kill "$pid"
      for _ in {1..50}; do
        if ! kill -0 "$pid" 2>/dev/null; then
          rm -f "$pid_file"
          pid=""
          break
        fi
        sleep 0.1
      done
      if [[ -n "$pid" ]]; then
        echo "error: process $pid is still running" >&2
        failed=1
      fi
    fi
  done
  if [[ "$failed" -ne 0 ]]; then
    exit 1
  fi
  echo "stopped Codoxear"
}

status_server() {
  local web_pid rust_pid
  if web_pid="$(running_pid "$WEB_PID_FILE")" && rust_pid="$(running_pid "$RUST_PID_FILE")"; then
    echo "running"
    echo "web pid: $web_pid"
    echo "rust pid: $rust_pid"
    echo "web log: $WEB_LOG_FILE"
    echo "rust log: $RUST_LOG_FILE"
    exit 0
  fi
  echo "stopped"
  exit 1
}

case "${1:-}" in
  start)
    start_server
    ;;
  stop)
    stop_server
    ;;
  restart)
    if running_pid "$WEB_PID_FILE" >/dev/null || running_pid "$RUST_PID_FILE" >/dev/null; then
      stop_server
    fi
    start_server
    ;;
  status)
    status_server
    ;;
  logs)
    mkdir -p "$ROOT_DIR/.tmp"
    touch "$WEB_LOG_FILE" "$RUST_LOG_FILE"
    exec tail -n 100 -f "$WEB_LOG_FILE" "$RUST_LOG_FILE"
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
